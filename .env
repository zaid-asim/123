# ─── REQUIRED: Swadesh AI Core ────────────────────────────────────────────────
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── OPTIONAL: Database (for persistent conversations & memories) ────────────
# Get a free PostgreSQL URL from: https://neon.tech OR https://supabase.com
# If not set, app runs in localStorage-only mode (fully functional for guests)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ─── OPTIONAL: Google Sign-In (for account-based features) ───────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# BASE_URL=http://localhost:5000

# ─── SESSION SECRET (auto-generated in dev if not set) ───────────────────────
# SESSION_SECRET=change_this_to_a_random_long_string_in_production
